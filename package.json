{
  "name": "iconify-collections",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "scripts": {
    "build": "run-s generate format:icons-json",
    "format:icons-json": "eslint packages/*/icons.json --fix --no-ignore",
    "generate": "tsx scripts/generateCollections.mts",
    "lint": "eslint",
    "play": "pnpm -C playground run dev",
    "play:build": "pnpm -C playground run build",
    "prepare": "husky",
    "publish": "pnpm generate && changeset publish",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@iconify/tools": "^5.0.11",
    "@ntnyq/eslint-config": "^6.0.1",
    "@ntnyq/prettier-config": "^3.0.1",
    "@types/node": "^24.12.2",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unocss": "^66.6.8",
    "vite": "^8.0.9",
    "vitest": "^4.1.4"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,md,svg,yml,yaml,json}": "eslint --fix"
  }
}
